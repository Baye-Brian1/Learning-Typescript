{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",

    "rootDir": "./src",
    "outDir": "./dist",

    "strict": true,
    "noImplicitAny": true,

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    "sourceMap": true,
    "declaration": true,
    "declarationMap": true
  },

  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}